# ─────────────────────────────────────────────────────────────
# ATS Engine — the ONLY env file. Copy this to `.env` at the
# repo root and fill it in. Do not create .env.local / .env.dev.
# Unprefixed vars are SERVER-ONLY. VITE_* vars reach the browser.
# ─────────────────────────────────────────────────────────────

# --- Supabase (server-only; service role bypasses RLS) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service-role...

# --- Supabase (client-safe) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...anon...

# --- OpenRouter: streaming chat (google/gemma-4-26b-a4b-it:free) ---
# Up to 2 keys, round-robined with cooldown on rate limits.
OPENROUTER_API_KEY_1=sk-or-v1-...
OPENROUTER_API_KEY_2=sk-or-v1-...

# --- Groq: agentic work (openai/gpt-oss-120b) ---
# Resume parsing, job-link extraction, matching, auto-apply drafting.
GROQ_API_KEY_1=gsk_...
GROQ_API_KEY_2=gsk_...
GROQ_API_KEY_3=gsk_...

SEED_DEMO_PASSWORD=anypassword

# --- Public app URL (sent to OpenRouter as HTTP-Referer) ---
APP_URL=http://localhost:5173

# --- Gmail delivery (offers, outreach, invites) ---
# Enable 2-Step Verification, then create an App Password at:
# https://myaccount.google.com/apppasswords
# Optional: without these, mail is recorded in `email_outbox` as queued.
GMAIL_USER=youraccount@gmail.com
GMAIL_APP_PASSWORD=abcdefghijkl
EMAIL_FROM_NAME="ATS Engine"
